<mujoco model="FluidArena">
  <compiler angle="radian"/>

  <option gravity="0 0 0" density="1000" viscosity="0.1"/>

  <size njmax="232" nconmax="56"/>

  <visual>
    <global azimuth="120" elevation="-20"/>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <default>
    <default class="SwimmerMorphology/main"/>
  </default>

  <asset>
    <texture type="2d" colorspace="auto" name="floor" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.15 0.2" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="floor" texture="floor" texrepeat="4 4" texuniform="true" reflectance="0.2"/>
  </asset>

  <worldbody>
    <geom name="floor" size="10 10 0.1" pos="0 0 -0.3" type="plane" contype="0" conaffinity="0" material="floor"/>
    <light name="top_light" pos="0 0 3" diffuse="0.8 0.8 0.8"/>
    <body name="SwimmerMorphology/segment_0">
      <joint name="SwimmerMorphology/freejoint" type="free"/>
      <geom name="SwimmerMorphology/segment_0_capsule" size="0.015 0.05" pos="0.05 0 0" quat="0.707107 0 -0.707107 0" type="capsule" rgba="0.55 0.65 0.9 1" fluidshape="ellipsoid" density="600"/>
      <camera name="SwimmerMorphology/tracking_camera" pos="0 0 2.5" mode="trackcom" fovy="60"/>
      <body name="SwimmerMorphology/segment_1" pos="0.1 0 0">
        <joint name="SwimmerMorphology/segment_1_joint" stiffness="0.01" range="-1.5 1.5" damping="0.005" limited="true"/>
        <geom name="SwimmerMorphology/segment_1_capsule" size="0.015 0.05" pos="0.05 0 0" quat="0.707107 0 -0.707107 0" type="capsule" rgba="0.55 0.65 0.9 1" fluidshape="ellipsoid" density="600"/>
        <body name="SwimmerMorphology/segment_2" pos="0.1 0 0">
          <joint name="SwimmerMorphology/segment_2_joint" stiffness="0.01" range="-1.5 1.5" damping="0.005" limited="true"/>
          <geom name="SwimmerMorphology/segment_2_capsule" size="0.015 0.05" pos="0.05 0 0" quat="0.707107 0 -0.707107 0" type="capsule" rgba="0.55 0.65 0.9 1" fluidshape="ellipsoid" density="600"/>
          <body name="SwimmerMorphology/segment_3" pos="0.1 0 0">
            <joint name="SwimmerMorphology/segment_3_joint" stiffness="0.01" range="-1.5 1.5" damping="0.005" limited="true"/>
            <geom name="SwimmerMorphology/segment_3_capsule" size="0.015 0.05" pos="0.05 0 0" quat="0.707107 0 -0.707107 0" type="capsule" rgba="0.55 0.65 0.9 1" fluidshape="ellipsoid" density="600"/>
            <body name="SwimmerMorphology/segment_4" pos="0.1 0 0">
              <joint name="SwimmerMorphology/segment_4_joint" stiffness="0.01" range="-1.5 1.5" damping="0.005" limited="true"/>
              <geom name="SwimmerMorphology/segment_4_capsule" size="0.015 0.05" pos="0.05 0 0" quat="0.707107 0 -0.707107 0" type="capsule" rgba="0.55 0.65 0.9 1" fluidshape="ellipsoid" density="600"/>
              <body name="SwimmerMorphology/segment_5" pos="0.1 0 0">
                <joint name="SwimmerMorphology/segment_5_joint" stiffness="0.01" range="-1.5 1.5" damping="0.005" limited="true"/>
                <geom name="SwimmerMorphology/segment_5_capsule" size="0.015 0.05" pos="0.05 0 0" quat="0.707107 0 -0.707107 0" type="capsule" rgba="0.55 0.65 0.9 1" fluidshape="ellipsoid" density="600"/>
                <body name="SwimmerMorphology/segment_6" pos="0.1 0 0">
                  <joint name="SwimmerMorphology/segment_6_joint" stiffness="0.01" range="-1.5 1.5" damping="0.005" limited="true"/>
                  <geom name="SwimmerMorphology/segment_6_capsule" size="0.015 0.05" pos="0.05 0 0" quat="0.707107 0 -0.707107 0" type="capsule" rgba="0.55 0.65 0.9 1" fluidshape="ellipsoid" density="600"/>
                  <body name="SwimmerMorphology/segment_7" pos="0.1 0 0">
                    <joint name="SwimmerMorphology/segment_7_joint" stiffness="0.01" range="-1.5 1.5" damping="0.005" limited="true"/>
                    <geom name="SwimmerMorphology/segment_7_capsule" size="0.015 0.05" pos="0.05 0 0" quat="0.707107 0 -0.707107 0" type="capsule" rgba="0.55 0.65 0.9 1" fluidshape="ellipsoid" density="600"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <general name="SwimmerMorphology/segment_1_joint_p_control" joint="SwimmerMorphology/segment_1_joint" ctrlrange="-6.28319 6.28319" ctrllimited="true" input="pos" biastype="affine" gainprm="2" biasprm="0 -2"/>
    <general name="SwimmerMorphology/segment_2_joint_p_control" joint="SwimmerMorphology/segment_2_joint" ctrlrange="-6.28319 6.28319" ctrllimited="true" input="pos" biastype="affine" gainprm="2" biasprm="0 -2"/>
    <general name="SwimmerMorphology/segment_3_joint_p_control" joint="SwimmerMorphology/segment_3_joint" ctrlrange="-6.28319 6.28319" ctrllimited="true" input="pos" biastype="affine" gainprm="2" biasprm="0 -2"/>
    <general name="SwimmerMorphology/segment_4_joint_p_control" joint="SwimmerMorphology/segment_4_joint" ctrlrange="-6.28319 6.28319" ctrllimited="true" input="pos" biastype="affine" gainprm="2" biasprm="0 -2"/>
    <general name="SwimmerMorphology/segment_5_joint_p_control" joint="SwimmerMorphology/segment_5_joint" ctrlrange="-6.28319 6.28319" ctrllimited="true" input="pos" biastype="affine" gainprm="2" biasprm="0 -2"/>
    <general name="SwimmerMorphology/segment_6_joint_p_control" joint="SwimmerMorphology/segment_6_joint" ctrlrange="-6.28319 6.28319" ctrllimited="true" input="pos" biastype="affine" gainprm="2" biasprm="0 -2"/>
    <general name="SwimmerMorphology/segment_7_joint_p_control" joint="SwimmerMorphology/segment_7_joint" ctrlrange="-6.28319 6.28319" ctrllimited="true" input="pos" biastype="affine" gainprm="2" biasprm="0 -2"/>
  </actuator>

  <sensor>
    <jointpos joint="SwimmerMorphology/segment_1_joint" name="SwimmerMorphology/segment_1_joint_jointpos_sensor"/>
    <jointvel joint="SwimmerMorphology/segment_1_joint" name="SwimmerMorphology/segment_1_joint_jointvel_sensor"/>
    <jointactuatorfrc joint="SwimmerMorphology/segment_1_joint" name="SwimmerMorphology/segment_1_joint_actuatorfrc_sensor"/>
    <jointpos joint="SwimmerMorphology/segment_2_joint" name="SwimmerMorphology/segment_2_joint_jointpos_sensor"/>
    <jointvel joint="SwimmerMorphology/segment_2_joint" name="SwimmerMorphology/segment_2_joint_jointvel_sensor"/>
    <jointactuatorfrc joint="SwimmerMorphology/segment_2_joint" name="SwimmerMorphology/segment_2_joint_actuatorfrc_sensor"/>
    <jointpos joint="SwimmerMorphology/segment_3_joint" name="SwimmerMorphology/segment_3_joint_jointpos_sensor"/>
    <jointvel joint="SwimmerMorphology/segment_3_joint" name="SwimmerMorphology/segment_3_joint_jointvel_sensor"/>
    <jointactuatorfrc joint="SwimmerMorphology/segment_3_joint" name="SwimmerMorphology/segment_3_joint_actuatorfrc_sensor"/>
    <jointpos joint="SwimmerMorphology/segment_4_joint" name="SwimmerMorphology/segment_4_joint_jointpos_sensor"/>
    <jointvel joint="SwimmerMorphology/segment_4_joint" name="SwimmerMorphology/segment_4_joint_jointvel_sensor"/>
    <jointactuatorfrc joint="SwimmerMorphology/segment_4_joint" name="SwimmerMorphology/segment_4_joint_actuatorfrc_sensor"/>
    <jointpos joint="SwimmerMorphology/segment_5_joint" name="SwimmerMorphology/segment_5_joint_jointpos_sensor"/>
    <jointvel joint="SwimmerMorphology/segment_5_joint" name="SwimmerMorphology/segment_5_joint_jointvel_sensor"/>
    <jointactuatorfrc joint="SwimmerMorphology/segment_5_joint" name="SwimmerMorphology/segment_5_joint_actuatorfrc_sensor"/>
    <jointpos joint="SwimmerMorphology/segment_6_joint" name="SwimmerMorphology/segment_6_joint_jointpos_sensor"/>
    <jointvel joint="SwimmerMorphology/segment_6_joint" name="SwimmerMorphology/segment_6_joint_jointvel_sensor"/>
    <jointactuatorfrc joint="SwimmerMorphology/segment_6_joint" name="SwimmerMorphology/segment_6_joint_actuatorfrc_sensor"/>
    <jointpos joint="SwimmerMorphology/segment_7_joint" name="SwimmerMorphology/segment_7_joint_jointpos_sensor"/>
    <jointvel joint="SwimmerMorphology/segment_7_joint" name="SwimmerMorphology/segment_7_joint_jointvel_sensor"/>
    <jointactuatorfrc joint="SwimmerMorphology/segment_7_joint" name="SwimmerMorphology/segment_7_joint_actuatorfrc_sensor"/>
    <framepos objtype="xbody" objname="SwimmerMorphology/segment_0" name="SwimmerMorphology/head_framepos_sensor"/>
    <framequat objtype="xbody" objname="SwimmerMorphology/segment_0" name="SwimmerMorphology/head_framequat_sensor"/>
    <framelinvel objtype="xbody" objname="SwimmerMorphology/segment_0" name="SwimmerMorphology/head_framelinvel_sensor"/>
    <frameangvel objtype="xbody" objname="SwimmerMorphology/segment_0" name="SwimmerMorphology/head_frameangvel_sensor"/>
  </sensor>

  <custom>
    <numeric name="brt_control_timestep" size="1" data="0.002"/>
  </custom>
</mujoco>
